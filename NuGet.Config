<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- CodeHub-FluentUI 3.1.0-codehub.1 未发布到 nuget.org，改用仓库自带的本地 feed。
         相对路径以本配置文件所在目录为基准，clone 后无需任何配置即可还原。
         若将来该包发布到 nuget.org，删掉这一行即可。 -->
    <add key="codehub-local" value="local-feed" />
  </packageSources>
</configuration>
