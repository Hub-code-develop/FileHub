<!--
  TabView tab strip — ported from WinUI 3.

  Source: microsoft/microsoft-ui-xaml  controls/dev/TabView/TabViewItem_themeresources.xaml
          and controls/dev/CommonStyles/Common_themeresources_any.xaml for the tokens.
  Copyright (c) Microsoft Corporation. Licensed under the MIT License.
  See THIRD-PARTY-NOTICES.md.

  WinUI geometry kept verbatim:
    strip height 40 (tab 32) · item MinWidth 100 / MaxWidth 240 · CornerRadius 8,8,0,0
    header padding 12,0,8,0 · close button 18x18 hit area, 8x8 glyph
  The close button fades in on hover / selection, the way WinUI's CloseButtonOverlayMode
  behaves for pointer input.

  Order matters: the item theme is declared first because the strip theme pins it through
  StaticResource (the inherited Fluent list theme would otherwise dress tabs as list rows).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:WinUI3.Fluent.Controls">

  <Styles.Resources>

    <ControlTheme x:Key="{x:Type c:WinTabStripItem}" TargetType="c:WinTabStripItem">
      <Setter Property="IsClosable" Value="True" />
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Padding" Value="12,0,8,0" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="MinWidth" Value="100" />
      <Setter Property="MaxWidth" Value="240" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="8,8,0,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />

      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1,1,1,0"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  VerticalAlignment="Bottom">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.083" />
              </Transitions>
            </Border.Transitions>

            <Grid ColumnDefinitions="*,18" ColumnSpacing="6">

              <ContentPresenter Grid.Column="0"
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left" />

              <Button Grid.Column="1"
                      Name="PART_CloseButton"
                      Width="18" Height="18" MinHeight="0"
                      Padding="0"
                      CornerRadius="4"
                      BorderThickness="0"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Opacity="0"
                      IsVisible="{TemplateBinding IsClosable}">
                <Button.Theme>
                  <ControlTheme TargetType="Button">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                      <ControlTemplate>
                        <Border Name="PART_ButtonRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                          <ContentPresenter Content="{TemplateBinding Content}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                        </Border>
                      </ControlTemplate>
                    </Setter>
                    <Style Selector="^:pointerover /template/ Border#PART_ButtonRoot">
                      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </Style>
                    <Style Selector="^:pressed /template/ Border#PART_ButtonRoot">
                      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                    </Style>
                  </ControlTheme>
                </Button.Theme>

                <!-- Dismiss glyph: two crossing strokes, the same shape WinUI draws at 8x8. -->
                <Path Data="M 0,0 L 8,8 M 8,0 L 0,8"
                      Stroke="{TemplateBinding Foreground}"
                      StrokeThickness="1"
                      StrokeLineCap="Round"
                      Width="8" Height="8"
                      Stretch="None"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
              </Button>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>

      <!-- WinUI: unselected tabs are transparent until hovered. -->
      <Style Selector="^:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
      </Style>

      <!-- WinUI: the selected tab takes the content surface colour so it merges with the page. -->
      <Style Selector="^:selected /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      </Style>

      <Style Selector="^:selected">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </Style>

      <Style Selector="^:selected:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
      </Style>

      <!-- Close button: hidden on unselected tabs, revealed on hover or when selected. -->
      <Style Selector="^:selected /template/ Button#PART_CloseButton">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^:pointerover /template/ Button#PART_CloseButton">
        <Setter Property="Opacity" Value="1" />
      </Style>

      <!-- Drag-reorder target: the same reveal WinUI uses for a tab drop slot. -->
      <Style Selector="^.drop-target /template/ Border#PART_Root">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="2,2,1,0" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type c:WinTabStrip}" TargetType="c:WinTabStrip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="ItemContainerTheme" Value="{StaticResource {x:Type c:WinTabStripItem}}" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter>
      <!-- The strip scrolls horizontally once the tabs outgrow the titlebar (WinUI overflow). -->
      <Setter Property="Template">
        <ControlTemplate>
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        BringIntoViewOnFocusChange="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
            <ItemsPresenter Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            Margin="{TemplateBinding Padding}" />
          </ScrollViewer>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

  </Styles.Resources>

</Styles>
