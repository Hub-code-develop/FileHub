<!--
  TabView tab strip — ported from WinUI 3.

  Source: microsoft/microsoft-ui-xaml  controls/dev/TabView/TabViewItem_themeresources.xaml
          and controls/dev/CommonStyles/Common_themeresources_any.xaml for the tokens.
  Copyright (c) Microsoft Corporation. Licensed under the MIT License.
  See THIRD-PARTY-NOTICES.md.

  WinUI geometry, adapted for a title bar: WinUI draws 32px content tabs with 8,8,0,0 corners
  that merge into the page below. Here the strip *is* the window's title bar, so the tabs are
  30px pills centred in a 44px row (7px radius, 108/208 min/max width, 10,0,4,0 padding), and the
  strip scrollbar is hidden in favour of wheel scrolling. The close button keeps WinUI's
  16x16 hit area with an 8x8 glyph and still fades in on hover / selection.

  Order matters: the item theme is declared first because the strip theme pins it through
  StaticResource (the inherited Fluent list theme would otherwise dress tabs as list rows).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:WinUI3.Fluent.Controls">

  <Styles.Resources>

    <ControlTheme x:Key="{x:Type c:WinTabStripItem}" TargetType="c:WinTabStripItem">
      <Setter Property="IsClosable" Value="True" />
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Padding" Value="10,0,4,0" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="MinWidth" Value="108" />
      <Setter Property="MaxWidth" Value="208" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />

      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  VerticalAlignment="Center">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.083" />
              </Transitions>
            </Border.Transitions>

            <!-- Tabs live in the title bar, so they are a rounded pill centred in the row rather
                 than WinUI's bottom-anchored content tab. 16x16 close button, 7x7 glyph. -->
            <Grid ColumnDefinitions="*,16" ColumnSpacing="4">

              <ContentPresenter Grid.Column="0"
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left" />

              <Button Grid.Column="1"
                      Name="PART_CloseButton"
                      Width="16" Height="16" MinHeight="0"
                      Padding="0"
                      CornerRadius="4"
                      BorderThickness="0"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Opacity="0"
                      IsVisible="{TemplateBinding IsClosable}">
                <Button.Theme>
                  <ControlTheme TargetType="Button">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                      <ControlTemplate>
                        <Border Name="PART_ButtonRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                          <ContentPresenter Content="{TemplateBinding Content}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                        </Border>
                      </ControlTemplate>
                    </Setter>
                    <Style Selector="^:pointerover /template/ Border#PART_ButtonRoot">
                      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </Style>
                    <Style Selector="^:pressed /template/ Border#PART_ButtonRoot">
                      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                    </Style>
                  </ControlTheme>
                </Button.Theme>

                <!-- Dismiss glyph: two crossing strokes, the same shape WinUI draws at 8x8. -->
                <Path Data="M 0,0 L 8,8 M 8,0 L 0,8"
                      Stroke="{TemplateBinding Foreground}"
                      StrokeThickness="1"
                      StrokeLineCap="Round"
                      Width="8" Height="8"
                      Stretch="None"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
              </Button>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>

      <!-- WinUI: unselected tabs are transparent until hovered. -->
      <Style Selector="^:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
      </Style>

      <!-- WinUI: the selected tab takes the content surface colour so it merges with the page. -->
      <Style Selector="^:selected /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      </Style>

      <Style Selector="^:selected">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </Style>

      <Style Selector="^:selected:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
      </Style>

      <!-- Close button: hidden on unselected tabs, revealed on hover or when selected. -->
      <Style Selector="^:selected /template/ Button#PART_CloseButton">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^:pointerover /template/ Button#PART_CloseButton">
        <Setter Property="Opacity" Value="1" />
      </Style>

      <!-- Drag-reorder target: the same reveal WinUI uses for a tab drop slot. -->
      <Style Selector="^.drop-target /template/ Border#PART_Root">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="2,2,1,0" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type c:WinTabStrip}" TargetType="c:WinTabStrip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="ItemContainerTheme" Value="{StaticResource {x:Type c:WinTabStripItem}}" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter>
      <!-- The strip scrolls horizontally once the tabs outgrow the title bar (WinUI overflow).
           The scrollbar itself stays hidden: a scrollbar inside a 44px title bar is noise, so
           the strip is scrolled by the wheel instead (see MainWindow.OnTabStripWheel).
           Both surfaces are background-less so presses on empty chrome fall through to the
           window's drag surface behind the strip. -->
      <Setter Property="Template">
        <ControlTemplate>
          <ScrollViewer Background="{x:Null}"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        BringIntoViewOnFocusChange="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
            <ItemsPresenter Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            Margin="{TemplateBinding Padding}" />
          </ScrollViewer>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

  </Styles.Resources>

</Styles>
