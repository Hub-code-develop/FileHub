<!--
  TextBlock / typography ramp — from the WinUI 3 type resources.
  Copyright (c) Microsoft Corporation. MIT License. See THIRD-PARTY-NOTICES.md.

  Caption 12 · Body 14 · BodyStrong 14 SemiBold · Subtitle 20
  Title 28 · TitleLarge 40 · Display 68
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ControlTheme x:Key="{x:Type TextBlock}" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource WinUIFontFamily}" />
      <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </ControlTheme>
  </Styles.Resources>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.body-strong">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.title-large">
    <Setter Property="FontSize" Value="40" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

</Styles>
