<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FileHub.Desktop</RootNamespace>
    <AssemblyName>FileHub</AssemblyName>
    <ApplicationTitle>FileHub</ApplicationTitle>
    <!-- Avalonia 12.1 默认开启编译绑定（要求每个 XAML 都写 x:DataType）。
         本项目用经典反射绑定，显式关掉，避免 XAML 编译期 AVLN2100。 -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!--
    macOS 27 kills the stock CoreCLR Mach-exception path, so the app runs on a CodeNet runtime.
    That runtime's GC crashes inside GC marking while a document is being loaded — the first
    version of document mode died within ~2s with SIGSEGV inside WKS::gc_heap::background_mark_*
    while scanning the handle table. Blocking GC instead of concurrent GC has kept repeated
    14-second document-mode runs alive; the cost is negligible for a desktop file manager, and
    the crash is not reachable through any FileHub code path (it is a runtime bug), so a switch
    is the only lever available here. Scoped to macOS: other platforms run the stock runtime.
  -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <!-- FluentUI-CodeHub：FluentAvalonia 的 CodeHub 分支，绑定 Avalonia 12.1.0 -->
    <PackageReference Include="CodeHub-FluentUI" Version="3.1.0-codehub.1" />
    <!-- Native WebView (WebView2 / WKWebView / WebKitGTK), MIT, AvaloniaUI OÜ. -->
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.2" />
  </ItemGroup>

  <!--
    A binary distribution must carry its licence and third-party notices: FileHub bundles MIT
    components (monaco-editor, Avalonia, SharpCompress, SSH.NET) and links SMBLibrary under
    LGPL-3.0. Copying them next to the executable keeps every download compliant.
  -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\licenses\**\*"
          Link="licenses\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Build channel metadata. CI overwrites this JSON before compiling so a downloaded binary can
    identify its own channel/version/commit; local builds keep the committed "dev" values.
    LogicalName keeps the resource id stable regardless of folder layout.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\version-ci.json" LogicalName="FileHub.Desktop.Assets.version-ci.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileHub.Files\FileHub.Files.csproj" />
    <ProjectReference Include="..\FileHub.Code\FileHub.Code.csproj" />
    <ProjectReference Include="..\FileHub.Office\FileHub.Office.csproj" />
    <!-- WinUI 3 控件样式的源码移植版（MIT，微软版权）。 -->
    <ProjectReference Include="..\WinUI3.Fluent\WinUI3.Fluent.csproj" />
  </ItemGroup>

  <!--
    monaco-editor 0.52.2 min/vs assets (MIT, Microsoft). Served from a loopback HTTP server so
    the editor works offline and AMD workers stay same-origin. See THIRD-PARTY-NOTICES.md.
  -->
  <ItemGroup>
    <Content Include="Assets\Monaco\**\*" Link="Assets\Monaco\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    CodeNet arm64 SDK（10.0.400）的 Microsoft.CSharp.CurrentVersion.targets 把
    CallTarget Targets="$(TargetsTriggeredByCompilation)" 整段注释掉了，
    Avalonia 12 的 CompileAvaloniaXaml 因此不会自动触发：
    构建显示 0 错误，但运行时报 "No precompiled XAML found"。
    这里在 CoreCompile 之后显式调用一次，保证 XAML 被编译进程序集。
    官方 SDK / CodeNet x64 SDK 自带该钩子；MSBuild 保证同一 Target 在一次构建中
    只执行一次，重复声明不会重复编译，因此在任何 SDK 上都安全。
  -->
  <Target Name="FileHubCompileAvaloniaXaml" AfterTargets="CoreCompile"
          DependsOnTargets="CompileAvaloniaXaml"
          Condition="'$(EnableAvaloniaXamlCompilation)' != 'false' and '$(DesignTimeBuild)' != 'true'" />

</Project>
