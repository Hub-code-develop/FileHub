<!--
  Visual values ported from the Files App (https://github.com/files-community/Files),
  Copyright (c) 2018 - present Files Community, MIT License.
  See THIRD-PARTY-NOTICES.md.

  Sizes and spacing mirror Files App XAML:
    NavigationToolbar  Height=48, Padding=4, buttons 36x32, ColumnSpacing=4
    TabBar             Margin=0,10,0,0, add button 30x30
    Toolbar            CornerRadius=8, DefaultLabelPosition=Right
    DetailsLayout      header Height=40, icon 20x20, row spacing 10/12
    InfoPane           tabs Height=32, CornerRadius=4, Padding=16,0
    StatusBar          MinHeight=32, Padding=8,0, divider 1x18, Spacing=8
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <!--
      Avalonia's stock GridSplitter template draws a rounded grip pill in the middle of the
      splitter. The panes on either side already carry their own hairline divider, so that grip
      showed up as a grey capsule floating between the file list and the info pane. Replace the
      template with a bare surface: invisible at rest, a 1px accent line while the pointer is on
      it (the splitter keeps its 3px hit area either way).
    -->
    <ControlTheme x:Key="{x:Type GridSplitter}" TargetType="GridSplitter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_SplitterRoot" Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#PART_SplitterRoot">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <!-- Window-level surfaces (Files MainPage: App.Theme.BackgroundBrush / Sidebar.BackgroundBrush) -->
  <Style Selector="Border.tabBarSurface">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="4,0,4,0" />
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
  </Style>

  <!--
    The title bar row. On macOS the window is chromeless, so this strip is the only piece of
    chrome above the content: it holds the traffic-light spacer, the tab strip and the window
    actions, and dragging it moves the window.
  -->
  <Style Selector="Border.titleBar">
    <Setter Property="Height" Value="44" />
    <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
  </Style>

  <Style Selector="Border.addressSurface">
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="4,0,4,0" />
  </Style>

  <Style Selector="Border.sidebarSurface">
    <Setter Property="Width" Value="230" />
    <Setter Property="Padding" Value="16,0,16,0" />
    <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
  </Style>

  <Style Selector="Border.omnibar">
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,0,6,0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
  </Style>

  <Style Selector="Border.paneSurface">
    <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
  </Style>

  <Style Selector="Border.statusSurface">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="8,0,8,0" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
  </Style>

  <!-- Sidebar: grouped headers and compact rows, like Files SidebarView -->
  <Style Selector="TextBlock.sidebarHeader">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="Margin" Value="8,14,4,6" />
  </Style>

  <Style Selector="Border.sidebarDivider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="4,6,4,6" />
    <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
  </Style>

  <!-- Files DetailsLayoutPage header: Height=40, left padding 24 -->
  <Style Selector="Border.columnHeaderSurface">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="10,0,12,0" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
  </Style>

  <Style Selector="Button.columnHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4,8,4" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <!-- Files list rows: 36px, 20px icon, hover / selected surfaces -->
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="10,2,10,2" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="TextBlock.gridTileName">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Border.gridTile">
    <Setter Property="Width" Value="120" />
    <Setter Property="Padding" Value="8,10,8,8" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!-- Files InfoPane tabs: Height=32, CornerRadius=4, Padding=16,0 -->
  <Style Selector="Button.paneTab">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="86" />
    <Setter Property="Padding" Value="16,0,16,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.paneTabPill">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="3" />
    <Setter Property="CornerRadius" Value="1" />
  </Style>

  <!-- Details pane typography -->
  <Style Selector="TextBlock.paneHeading">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.paneName">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.paneLabel">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.65" />
  </Style>

  <Style Selector="TextBlock.paneValue">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Status bar: 32px rows, 24px buttons, 1x18 dividers -->
  <Style Selector="TextBlock.statusText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.statusButton">
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Padding" Value="8,0,8,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.statusDivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Margin" Value="8,0,8,0" />
    <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
  </Style>

  <!-- Small square buttons in the tab strip / navigation toolbar -->
  <Style Selector="Button.tabAction">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Window actions in the title bar (new tab / language / settings): 28px tall, tight radius,
       so they read as window chrome rather than as toolbar buttons. -->
  <Style Selector="Button.titleBarAction">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- Self-drawn window buttons for the platforms where extending the client area removes the
       decorations without leaving system buttons behind (Linux/X11). Sized and spaced like the
       Windows caption buttons so the title bar reads the same everywhere. -->
  <Style Selector="Button.captionButton">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Path.glyph">
    <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>

  <Style Selector="Button.captionClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#C42B1C" />
  </Style>

  <Style Selector="Button.captionClose:pointerover Path.glyph">
    <Setter Property="Stroke" Value="White" />
  </Style>

</Styles>
