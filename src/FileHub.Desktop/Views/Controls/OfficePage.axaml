<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:FileHub.Desktop.Services"
             xmlns:m="using:FileHub.Office.Models"
             x:Class="FileHub.Desktop.Views.Controls.OfficePage">

  <!--
    Microsoft Office style workspace: title strip, ribbon tabs + ribbon groups, document canvas,
    status bar. The ribbon is built from the same WinUI 3 styled Button/ComboBox resources used by
    the rest of FileHub; the layout follows Word/Excel's tab+group hierarchy.
  -->
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

    <!-- Title strip -->
    <Border Grid.Row="0" Classes="paneSurface" Padding="12,8">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">
        <Button Grid.Column="0" Content="{x:Static loc:Strings.ClosePage}"
                Command="{Binding CloseCommand}" Padding="10,4" />
        <Border Grid.Column="1" Width="4" Height="22" Margin="12,0,0,0" CornerRadius="2"
                Background="#2B579A" />
        <StackPanel Grid.Column="2" Margin="10,0,0,0" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="*" IsVisible="{Binding IsDirty}" Foreground="#D13438" FontSize="15" />
          </StackPanel>
          <TextBlock Text="{Binding FilePath}" Opacity="0.6" FontSize="11"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="3" Text="{Binding DocumentTypeLabel}" Opacity="0.65"
                   FontSize="12" Margin="12,0,0,0" />
      </Grid>
    </Border>

    <!-- Ribbon tab row -->
    <Border Grid.Row="1" Padding="12,0" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Content="{x:Static loc:Strings.OfficeTabFile}" Command="{Binding SelectTabCommand}"
                CommandParameter="File" Classes="subtle" Padding="14,6" />
        <Button Content="{x:Static loc:Strings.OfficeTabHome}" Command="{Binding SelectTabCommand}"
                CommandParameter="Home" Classes="subtle" Padding="14,6" />
        <Button Content="{x:Static loc:Strings.OfficeTabInsert}" Command="{Binding SelectTabCommand}"
                CommandParameter="Insert" Classes="subtle" Padding="14,6" />
        <Button Content="{x:Static loc:Strings.OfficeTabView}" Command="{Binding SelectTabCommand}"
                CommandParameter="View" Classes="subtle" Padding="14,6" />
      </StackPanel>
    </Border>

    <!-- Ribbon groups -->
    <Border Grid.Row="2" Classes="paneSurface" Padding="12,8" MinHeight="74"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">

        <!-- File group -->
        <StackPanel Orientation="Horizontal" Spacing="6">
          <StackPanel Spacing="3">
            <Button Content="{x:Static loc:Strings.OfficeNew}" Command="{Binding CreateNewCommand}"
                    ToolTip.Tip="{x:Static loc:Strings.OfficeNewHint}" Padding="10,4" />
            <Button Content="{x:Static loc:Strings.OfficeSave}" Command="{Binding SaveCommand}"
                    ToolTip.Tip="Ctrl+S" Padding="10,4" />
          </StackPanel>
          <TextBlock Text="{x:Static loc:Strings.OfficeGroupFile}" FontSize="10" Opacity="0.55"
                     VerticalAlignment="Bottom" Margin="0,0,0,2" />
        </StackPanel>

        <!-- Font group (Word) -->
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsWord}">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ToggleButton Content="B" FontWeight="Bold" IsChecked="{Binding IsBold}"
                            ToolTip.Tip="{x:Static loc:Strings.OfficeBold}" Width="30" />
              <ToggleButton Content="I" FontStyle="Italic" IsChecked="{Binding IsItalic}"
                            ToolTip.Tip="{x:Static loc:Strings.OfficeItalic}" Width="30" />
              <ToggleButton Content="U" IsChecked="{Binding IsUnderline}"
                            ToolTip.Tip="{x:Static loc:Strings.OfficeUnderline}" Width="30" />
            </StackPanel>
            <ComboBox ItemsSource="{Binding StyleOptions}" SelectedItem="{Binding SelectedStyle}"
                      MinWidth="160" FontSize="12" />
          </StackPanel>
          <TextBlock Text="{x:Static loc:Strings.OfficeGroupFont}" FontSize="10" Opacity="0.55"
                     VerticalAlignment="Bottom" Margin="0,0,0,2" />
        </StackPanel>

        <!-- Workbook group (Excel) -->
        <StackPanel IsVisible="{Binding IsExcel}" Spacing="4">
          <TextBlock Text="{x:Static loc:Strings.OfficeExcelHint}" FontSize="12" Opacity="0.8" />
          <TextBlock Text="{x:Static loc:Strings.OfficeGroupCells}" FontSize="10" Opacity="0.55" />
        </StackPanel>

        <!-- Slide group (PowerPoint) -->
        <StackPanel IsVisible="{Binding IsPowerPoint}" Spacing="4">
          <TextBlock Text="{x:Static loc:Strings.OfficeReadOnlyHint}" FontSize="12" Opacity="0.8" />
          <TextBlock Text="{x:Static loc:Strings.OfficeGroupSlides}" FontSize="10" Opacity="0.55" />
        </StackPanel>

        <!-- New-document box -->
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
          <TextBox Text="{Binding NewFileName}" PlaceholderText="{x:Static loc:Strings.OfficeNewNameHint}"
                   MinWidth="140" FontSize="12" VerticalAlignment="Center"
                   KeyDown="OnNewNameKeyDown" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Document canvas -->
    <Grid Grid.Row="3">
      <!-- Empty state -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                  IsVisible="{Binding !HasDocument}">
        <TextBlock Text="{x:Static loc:Strings.OfficeEmpty}" FontSize="16" Opacity="0.6"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{x:Static loc:Strings.OfficeEmptyHint}" FontSize="12" Opacity="0.5"
                   HorizontalAlignment="Center" />
      </StackPanel>

      <!-- Word: paragraph list -->
      <ScrollViewer IsVisible="{Binding IsWord}">
        <ItemsControl ItemsSource="{Binding Paragraphs}" Margin="32,24,32,40">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="m:WordParagraph">
              <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap"
                       BorderThickness="0" Background="Transparent" Padding="4,3"
                       FontSize="14" LostFocus="OnParagraphLostFocus"
                       GotFocus="OnParagraphGotFocus" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Excel: grid -->
      <ScrollViewer IsVisible="{Binding IsExcel}" HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Sheets}" x:Name="SheetList">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="m:ExcelSheet">
              <StackPanel Margin="16,12">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Cells}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="m:ExcelCell">
                      <Border BorderThickness="0,0,1,1"
                              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                              Width="100" MinHeight="26">
                        <TextBox Text="{Binding Text}" BorderThickness="0" Background="Transparent"
                                 FontSize="12" Padding="4,3" LostFocus="OnCellLostFocus"
                                 GotFocus="OnCellGotFocus" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- PowerPoint: slide outline -->
      <ScrollViewer IsVisible="{Binding IsPowerPoint}">
        <ItemsControl ItemsSource="{Binding Slides}" Margin="32,24,32,40">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="m:PowerPointSlide">
              <Border Classes="paneSurface" Padding="16" Margin="0,0,0,14" CornerRadius="6">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Number, StringFormat='Slide {0}'}" FontSize="11" Opacity="0.6" />
                  <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="13" Margin="12,0,0,0"
                                   TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="4" Classes="paneSurface" Padding="12,5">
      <StackPanel Orientation="Horizontal" Spacing="18">
        <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.8"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding DocumentTypeLabel}" FontSize="11" Opacity="0.6" />
        <TextBlock Text="{x:Static loc:Strings.OfficeDisclaimer}" FontSize="11" Opacity="0.5" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
