<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:FileHub.Desktop.Services"
             xmlns:m="using:FileHub.Code.Models"
             x:Class="FileHub.Desktop.Views.Controls.ExtensionsPage">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

    <Border Grid.Row="0" Classes="paneSurface" Padding="12,8">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">
        <Button Grid.Column="0" Content="{x:Static loc:Strings.ClosePage}"
                Command="{Binding CloseCommand}" Padding="10,4" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
          <ToggleButton Content="{x:Static loc:Strings.MktInstalledTab}"
                        IsChecked="{Binding IsInstalledMode, Mode=TwoWay}"
                        Command="{Binding ShowInstalledCommand}" Padding="10,4" />
          <ToggleButton Content="{x:Static loc:Strings.MktMarketplaceTab}"
                        IsChecked="{Binding IsMarketplaceMode, Mode=TwoWay}"
                        Command="{Binding ShowMarketplaceCommand}" Padding="10,4" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{x:Static loc:Strings.ExtTitle}"
                   Margin="12,0,0,0" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="12" Opacity="0.7" />
      </Grid>
    </Border>

    <!-- Installed toolbar -->
    <Border Grid.Row="1" Padding="12,6" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            IsVisible="{Binding IsInstalledMode}">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBox Text="{Binding Search, Mode=TwoWay}" PlaceholderText="{x:Static loc:Strings.ExtSearchPlaceholder}"
                 Width="320" VerticalAlignment="Center" />
        <Button Content="{x:Static loc:Strings.ExtRefresh}" Command="{Binding RefreshCommand}"
                Padding="10,4" />
      </StackPanel>
    </Border>

    <!-- Marketplace toolbar -->
    <Border Grid.Row="1" Padding="12,6" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            IsVisible="{Binding IsMarketplaceMode}">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBox x:Name="MarketplaceQuery" Text="{Binding MarketplaceSearch, Mode=TwoWay}"
                 PlaceholderText="{x:Static loc:Strings.MktSearchPlaceholder}"
                 Width="360" VerticalAlignment="Center" KeyDown="OnMarketplaceKeyDown" />
        <Button Content="{x:Static loc:Strings.MktSearch}" Command="{Binding SearchMarketplaceCommand}"
                Padding="10,4" />
        <TextBlock Text="{Binding PlatformText}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Installed list -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,340" IsVisible="{Binding IsInstalledMode}">
      <ListBox Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
               Margin="8" SelectionMode="Single">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="m:ExtensionInfo">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="6,4">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Subtitle}" FontSize="11"
                         Opacity="0.65" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Version}" FontSize="11"
                         Opacity="0.6" Margin="10,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Column="1" Width="3" Background="Transparent" ResizeDirection="Columns" />

      <Border Grid.Column="2" Classes="paneSurface" Margin="0,8,8,8" Padding="14">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer Grid.Row="0">
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" LineHeight="20" />
          </ScrollViewer>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" Padding="10,4" />
            <Button Content="{x:Static loc:Strings.MktUninstall}" Command="{Binding UninstallCommand}"
                    Padding="10,4" />
            <Button Content="{x:Static loc:Strings.ExtOpenFolder}" Command="{Binding OpenFolderCommand}"
                    Padding="10,4" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Marketplace list -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,340" IsVisible="{Binding IsMarketplaceMode}">
      <ListBox Grid.Column="0" ItemsSource="{Binding MarketplaceItems}"
               SelectedItem="{Binding SelectedMarketplace, Mode=TwoWay}"
               Margin="8" SelectionMode="Single">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="m:MarketplaceExtension">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="6,4">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Id}" FontSize="11"
                         Opacity="0.65" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Version}" FontSize="11"
                         Opacity="0.6" Margin="10,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Column="1" Width="3" Background="Transparent" ResizeDirection="Columns" />

      <Border Grid.Column="2" Classes="paneSurface" Margin="0,8,8,8" Padding="14">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer Grid.Row="0">
            <TextBlock Text="{Binding MarketplaceSummary}" TextWrapping="Wrap" FontSize="12"
                       LineHeight="20" />
          </ScrollViewer>
          <StackPanel Grid.Row="1" Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="{x:Static loc:Strings.MktNotice}" FontSize="10" Opacity="0.6"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{Binding InstallLabel}" Command="{Binding InstallCommand}" Padding="10,4" />
              <Button Content="{x:Static loc:Strings.MktOpenStore}" Command="{Binding OpenStorePageCommand}"
                      Padding="10,4" />
              <Button Content="{x:Static loc:Strings.MktLicense}" Command="{Binding OpenLicenseCommand}"
                      Padding="10,4" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Classes="paneSurface" Padding="12,5">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.75"
                   TextTrimming="CharacterEllipsis" IsVisible="{Binding Status.Length}" />
        <ProgressBar Height="3" Minimum="0" Maximum="1" Value="{Binding Progress}"
                     IsVisible="{Binding IsBusy}" />
        <TextBlock Text="{Binding ScanText}" FontSize="11" Opacity="0.7"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{x:Static loc:Strings.ExtNotice}" FontSize="11" Opacity="0.6"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
