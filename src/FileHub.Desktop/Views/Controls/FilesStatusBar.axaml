<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:loc="using:FileHub.Desktop.Services"
             x:Class="FileHub.Desktop.Views.Controls.FilesStatusBar">

  <!--
    Ported from Files App src/Files.App/UserControls/StatusBar.xaml
    (Copyright (c) Files Community, MIT License; see THIRD-PARTY-NOTICES.md).
    Files: MinHeight=32, dividers 1x18, InfoArea (item count / selection count / size)
    followed by StandardActions. Git and encoding actions are omitted: they need
    Files' Git back end and text editor integration, neither of which exists here.
  -->
  <Border Classes="statusSurface">
    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
      <TextBlock Grid.Column="0" Classes="statusText" Text="{Binding StatusText}" />
      <Border Grid.Column="1" Classes="statusDivider" />
      <TextBlock Grid.Column="2" Classes="statusText" Text="{Binding SelectionText}" />
      <Border Grid.Column="3" Classes="statusDivider" />
      <TextBlock Grid.Column="4" Classes="statusText" FontSize="11" Opacity="0.6"
                 Text="{Binding PlatformText}" />

      <TextBlock Grid.Column="5" Classes="statusText" FontSize="11" Opacity="0.6"
                 HorizontalAlignment="Right" Margin="0,0,8,0"
                 Text="{Binding SortIndicator}" />

      <Button Grid.Column="6" Classes="statusButton"
              ToolTip.Tip="{x:Static loc:Strings.ToggleView}"
              Command="{Binding ToggleViewCommand}">
        <ui:FASymbolIcon Symbol="ViewAll" FontSize="14" />
      </Button>
      <Button Grid.Column="7" x:Name="_detailsToggle" Classes="statusButton"
              ToolTip.Tip="{x:Static loc:Strings.ToggleDetailsPane}">
        <ui:FASymbolIcon Symbol="ContactInfo" FontSize="14" />
      </Button>
      <Button Grid.Column="8" Classes="statusButton"
              ToolTip.Tip="{x:Static loc:Strings.LblStatusCenter}">
        <ui:FASymbolIcon Symbol="Accept" FontSize="14" />
      </Button>
    </Grid>
  </Border>
</UserControl>
