<!--
  Files Toolbar — ported from Files App src/Files.App/UserControls/Toolbar.xaml
  (Copyright (c) 2018 - present Files Community, MIT License; see THIRD-PARTY-NOTICES.md).

  Files' Toolbar.xaml leaves its CommandBars empty and fills them from CommandManager in
  code-behind ("Primary commands are populated dynamically in code-behind"). FileHub does
  the same: the two panels below are populated from ShellViewModel.Commands.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FileHub.Desktop.Views.Controls.FilesToolbar">

  <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource OverlayCornerRadius}">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" x:Name="_primaryBar"
                  Orientation="Horizontal" Margin="4,0,0,0" />
      <StackPanel Grid.Column="1" x:Name="_secondaryBar"
                  Orientation="Horizontal" Margin="0,0,4,0" />
    </Grid>
  </Border>
</UserControl>
