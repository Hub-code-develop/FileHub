<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FileHub.Files</RootNamespace>
  </PropertyGroup>

  <!--
    Location providers. SharpCompress reads zip/tar/gz/bz2/xz/7z and rar without native code;
    SSH.NET provides SFTP; SMBLibrary provides SMB2/3 so a NAS share browses like a folder.
    All three are MIT/BSD-licensed; see THIRD-PARTY-NOTICES.md.
  -->
  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="SSH.NET" Version="2026.0.1" />
    <PackageReference Include="SMBLibrary" Version="1.5.8.1" />
  </ItemGroup>

</Project>
